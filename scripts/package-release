#!/bin/sh
set -eu

if [ "$#" -ne 3 ]; then
  printf 'Usage: %s GITHUB_OWNER vMAJOR.MINOR.PATCH OUTPUT_DIRECTORY\n' "$0" >&2
  exit 2
fi
owner=$1
version=$2
output_dir=$3
if ! printf '%s\n' "$owner" | grep -Eq '^[a-zA-Z0-9][a-zA-Z0-9-]*$' ||
   ! printf '%s\n' "$version" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
  printf 'Expected a GitHub owner and a version such as v0.1.0.\n' >&2
  exit 2
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
mkdir -p "$output_dir"
output_dir=$(CDPATH= cd -- "$output_dir" && pwd -P)
if [ "$output_dir" = "$root" ]; then
  printf 'Choose an output directory outside the project root to preserve install.sh.\n' >&2
  exit 2
fi
archive=$output_dir/llmao-$version.tar.gz
COPYFILE_DISABLE=1 tar -czf "$archive" -C "$root" llmao.plugin.zsh install.sh README.md
checksum=$(shasum -a 256 < "$archive")
checksum=${checksum%% *}
render() {
  sed -e "s/@OWNER@/$owner/g" -e "s/@TAG@/$version/g" \
      -e "s/@VERSION@/${version#v}/g" -e "s/@SHA256@/$checksum/g" "$1"
}

render "$root/scripts/llmao.rb.in" > "$output_dir/llmao.rb"
render "$root/scripts/install-release.sh.in" > "$output_dir/install.sh"
chmod +x "$output_dir/install.sh"

printf '%s\n' "$archive" "$output_dir/llmao.rb" "$output_dir/install.sh"
